<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>京葉線の駅</title>
</head>
<body>
  <h2>京葉線の駅一覧</h2>
  <table>
    <tr><th>ID</th><th>駅コード</th><th>駅名</th></tr>
    <% data.forEach( (row, number) => { %>
      <tr>
        <td><%= row.id %></td>
        <td><%= row.code %></td>
        <td><a href="/keiyo2/<%= number %>"><%= row.name %></a></td>
      </tr>
    <% }) %>
  </table>
</body>
</html>
